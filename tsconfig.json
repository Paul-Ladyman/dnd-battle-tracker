{
  "compilerOptions": {
    "outDir": "./dist",
    "sourceMap": true,
    "strictNullChecks": true,

    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",

    "jsx": "react-jsx",

    "allowJs": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["./src"]
}